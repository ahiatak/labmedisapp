<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LABMEDIS.Core\LABMEDIS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gives access to Hub/IHubContext<T> (Microsoft.AspNetCore.SignalR.Core) for
         Hubs/NotificationHub.cs — plan.md places Hubs under LABMEDIS.Service, and this
         project's plain (non-Web) SDK does not otherwise carry the ASP.NET Core shared
         framework. Does not pull in hosting/Kestrel — only the framework's API surface. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.*" />
    <PackageReference Include="DinkToPdf" Version="1.0.*" />
    <PackageReference Include="FluentEmail.Core" Version="3.*" />
    <PackageReference Include="FluentEmail.Smtp" Version="3.*" />
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.*" />
    <PackageReference Include="NLog" Version="5.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.*" />
    <PackageReference Include="Twilio" Version="7.*" />
    <PackageReference Include="UAParser" Version="3.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
